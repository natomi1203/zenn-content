{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ptd/assignment-query-row.schema.json",
  "title": "PTD train-only alternating-assignment query row",
  "type": "object",
  "required": [
    "date",
    "user_id",
    "click_history_most_recent_first",
    "purchase_history_most_recent_first",
    "candidates"
  ],
  "properties": {
    "date": {"enum": ["2026-07-18", "2026-07-19", "2026-07-20"]},
    "user_id": {"type": "string", "minLength": 1},
    "click_history_most_recent_first": {
      "type": "array",
      "items": {"type": "integer"},
      "maxItems": 30
    },
    "purchase_history_most_recent_first": {
      "type": "array",
      "items": {"type": "integer"},
      "maxItems": 30
    },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["product_id", "category", "click_label", "purchase_label", "teacher_purchase"],
        "properties": {
          "product_id": {"type": "integer"},
          "category": {"type": "string"},
          "click_label": {"enum": [0, 1]},
          "purchase_label": {"enum": [0, 1]},
          "teacher_purchase": {"type": "number", "minimum": 0, "maximum": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

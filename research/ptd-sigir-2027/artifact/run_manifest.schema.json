{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ptd/run-manifest.schema.json",
  "title": "Admissible prospective PTD run manifest",
  "type": "object",
  "required": [
    "schema_version",
    "status",
    "run_id",
    "created_at",
    "test_scoring_started_at",
    "completed_at",
    "code_revision",
    "source_contract",
    "method_contract",
    "teacher",
    "split",
    "seeds",
    "assertions",
    "variants",
    "selected_hyperparameters",
    "validation_selection",
    "tree",
    "latency_protocol",
    "execution",
    "deviations"
  ],
  "properties": {
    "schema_version": {"const": "ptd-run-manifest/v1"},
    "status": {"const": "complete"},
    "run_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "test_scoring_started_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": "string", "format": "date-time"},
    "code_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "source_contract": {
      "type": "object",
      "required": [
        "contract_version",
        "manifest_uri",
        "manifest_sha256",
        "source_contract_sha256",
        "raw_input_inventory_uri",
        "raw_input_inventory_sha256",
        "raw_sequence_contract_uri",
        "raw_sequence_contract_sha256",
        "item_universe_audit_uri",
        "item_universe_audit_sha256"
      ],
      "properties": {
        "contract_version": {"const": "shared_bottom_esmm_v2_source"},
        "manifest_uri": {"type": "string", "minLength": 1},
        "manifest_sha256": {"const": "33e97c72a3925b5b1ffe5550fbf625e82cacf78f18e073c0be9a2718b4fa1748"},
        "source_contract_sha256": {"const": "900637a45b8cbb84f4bdd15400db3f1a4eae8c0228b4a4b812c2968493abba91"},
        "raw_input_inventory_uri": {"type": "string", "minLength": 1},
        "raw_input_inventory_sha256": {"const": "d28d69f602b3782f923190768b0d2efc64104c456c9b7b961ea457ed04a31db3"},
        "raw_sequence_contract_uri": {"type": "string", "minLength": 1},
        "raw_sequence_contract_sha256": {"const": "c22332825f6baeab6375040f03fad5ed599f893d37e1ba78e215b0016d8ef4b7"},
        "item_universe_audit_uri": {"type": "string", "minLength": 1},
        "item_universe_audit_sha256": {"const": "11293abab08c86bf386963d92c27daf116612d590c1a54d65771bdc442147415"}
      },
      "additionalProperties": false
    },
    "method_contract": {
      "type": "object",
      "required": ["uri", "sha256"],
      "properties": {
        "uri": {"type": "string", "minLength": 1},
        "sha256": {"const": "8fd008bcfddfaeda74f6c6cddfab5b644e664bb5aa645ca778a94a788c5fcfee"}
      },
      "additionalProperties": false
    },
    "teacher": {
      "type": "object",
      "required": ["teacher_id", "frozen", "score", "artifact"],
      "properties": {
        "teacher_id": {"const": "legacy_loss_shared_bottom_esmm_v2"},
        "frozen": {"const": true},
        "score": {"const": "pCTR*pCVR"},
        "artifact": {
          "type": "object",
          "required": ["uri", "sha256"],
          "properties": {
            "uri": {"type": "string", "minLength": 1},
            "sha256": {"const": "5a435e4ea2579ca226f26fd8dfa5ad48a7be016f3d1a8e61798ce1b2d6ed1540"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "split": {"$ref": "#/$defs/split"},
    "seeds": {"const": [16630, 16631, 16632]},
    "assertions": {"$ref": "#/$defs/assertions"},
    "variants": {
      "type": "object",
      "required": [
        "fixed_tdm",
        "ptd_item",
        "ptd_node",
        "ptd_combined",
        "alternating_tdm",
        "alternating_ptd",
        "ptd_combined_baseline_encoder",
        "teacher_oracle"
      ],
      "properties": {
        "fixed_tdm": {"$ref": "#/$defs/run_variant"},
        "ptd_item": {"$ref": "#/$defs/run_variant"},
        "ptd_node": {"$ref": "#/$defs/run_variant"},
        "ptd_combined": {"$ref": "#/$defs/run_variant"},
        "alternating_tdm": {"$ref": "#/$defs/run_variant"},
        "alternating_ptd": {"$ref": "#/$defs/run_variant"},
        "ptd_combined_baseline_encoder": {"$ref": "#/$defs/run_variant"},
        "teacher_oracle": {"$ref": "#/$defs/run_variant"}
      },
      "additionalProperties": false
    },
    "selected_hyperparameters": {
      "type": "object",
      "required": [
        "selection_seed",
        "temperature",
        "lambda_item",
        "lambda_node",
        "epsilon_item",
        "epsilon_node",
        "assignment_weight",
        "selection_artifact"
      ],
      "properties": {
        "selection_seed": {"const": 16630},
        "temperature": {"enum": [1.0, 2.0, 4.0]},
        "lambda_item": {"enum": [0.1, 0.3, 1.0]},
        "lambda_node": {"enum": [0.1, 0.3, 1.0]},
        "epsilon_item": {"const": 0.000001},
        "epsilon_node": {"const": 0.000000000001},
        "assignment_weight": {"const": "y_plus_teacher_times_path_log_probability"},
        "selection_artifact": {"$ref": "#/$defs/artifact"}
      },
      "additionalProperties": false
    },
    "validation_selection": {
      "type": "object",
      "required": ["selection_seed", "selection_metric", "best_single_variant", "artifact"],
      "properties": {
        "selection_seed": {"const": 16630},
        "selection_metric": {"const": "purchase_ndcg_at_50"},
        "best_single_variant": {"enum": ["ptd_item", "ptd_node"]},
        "artifact": {"$ref": "#/$defs/artifact"}
      },
      "additionalProperties": false
    },
    "tree": {
      "type": "object",
      "required": [
        "branching_factor",
        "depth",
        "leaf_capacity",
        "beam_width",
        "catalog_order_sha256",
        "item_universe_audit_sha256",
        "date_eligibility_sha256",
        "alternating_cycles_selected_by_variant_and_seed",
        "locked_before_test",
        "locked_at",
        "locked_bundle_sha256"
      ],
      "properties": {
        "branching_factor": {"const": 2},
        "depth": {"const": 13},
        "leaf_capacity": {"const": 1},
        "beam_width": {"const": 600},
        "catalog_order_sha256": {"const": "dd41695bb4de9a7d09bae0237cdb2f0c5f1a08b572a5647cdba9c5165bb31d61"},
        "item_universe_audit_sha256": {"const": "11293abab08c86bf386963d92c27daf116612d590c1a54d65771bdc442147415"},
        "date_eligibility_sha256": {
          "type": "object",
          "required": ["2026-08-12", "2026-08-14", "2026-08-25", "2026-08-26", "2026-08-28"],
          "properties": {
            "2026-08-12": {"const": "5e71dc506230819f22f35527310c5c241a705300c0e61bfb5a6ee5ef537a03d4"},
            "2026-08-14": {"const": "5600039a543faa8235b26b3a052f870acb2e64ecdbd36c950390f65519367927"},
            "2026-08-25": {"const": "e1fc0e68422812a637a6ba1eb46b25c0e7cbe9ac1460b71096712910ba156dd8"},
            "2026-08-26": {"const": "bb63904e1b8863f0632381a26d1f5917feabdeacbbbb3625886a6980826f7861"},
            "2026-08-28": {"const": "fcc577e51c932f81b5f7c99f7f8a1a754c8013e8dd329c338be195919b7ab46a"}
          },
          "additionalProperties": false
        },
        "alternating_cycles_selected_by_variant_and_seed": {
          "type": "object",
          "required": ["alternating_tdm", "alternating_ptd"],
          "properties": {
            "alternating_tdm": {"$ref": "#/$defs/cycle_map"},
            "alternating_ptd": {"$ref": "#/$defs/cycle_map"}
          },
          "additionalProperties": false
        },
        "locked_before_test": {"const": true},
        "locked_at": {"type": "string", "format": "date-time"},
        "locked_bundle_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "latency_protocol": {
      "type": "object",
      "required": [
        "baseline_variant",
        "p95_relative_ceiling",
        "warmup_queries",
        "measured_queries",
        "concurrency",
        "hardware",
        "software",
        "timer"
      ],
      "properties": {
        "baseline_variant": {"const": "fixed_tdm"},
        "p95_relative_ceiling": {"const": 1.2},
        "warmup_queries": {"type": "integer", "minimum": 100},
        "measured_queries": {"type": "integer", "minimum": 1000},
        "concurrency": {"const": 1},
        "hardware": {"type": "string", "minLength": 1},
        "software": {"type": "string", "minLength": 1},
        "timer": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "execution": {
      "type": "object",
      "required": ["fit_schedule", "retrieval_plan", "retrieval_metrics_manifest"],
      "properties": {
        "fit_schedule": {"$ref": "#/$defs/artifact"},
        "retrieval_plan": {"$ref": "#/$defs/artifact"},
        "retrieval_metrics_manifest": {"$ref": "#/$defs/artifact"}
      },
      "additionalProperties": false
    },
    "deviations": {"type": "array", "maxItems": 0}
  },
  "$defs": {
    "cycle_map": {
      "type": "object",
      "required": ["16630", "16631", "16632"],
      "properties": {
        "16630": {"type": "integer", "minimum": 0, "maximum": 3},
        "16631": {"type": "integer", "minimum": 0, "maximum": 3},
        "16632": {"type": "integer", "minimum": 0, "maximum": 3}
      },
      "additionalProperties": false
    },
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifact": {
      "type": "object",
      "required": ["uri", "sha256"],
      "properties": {
        "uri": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "split": {
      "type": "object",
      "required": ["train", "validation", "test"],
      "properties": {
        "train": {"const": ["2026-07-18", "2026-07-19", "2026-07-20"]},
        "validation": {"const": ["2026-07-21"]},
        "test": {"const": ["2026-08-12", "2026-08-14", "2026-08-25", "2026-08-26", "2026-08-28"]}
      },
      "additionalProperties": false
    },
    "assertions": {
      "type": "object",
      "required": [
        "point_in_time_safe",
        "candidate_universe_match",
        "unique_keys",
        "finite_scores",
        "tree_locked_before_test",
        "teacher_frozen",
        "code_hash_match"
      ],
      "properties": {
        "point_in_time_safe": {"const": true},
        "candidate_universe_match": {"const": true},
        "unique_keys": {"const": true},
        "finite_scores": {"const": true},
        "tree_locked_before_test": {"const": true},
        "teacher_frozen": {"const": true},
        "code_hash_match": {"const": true}
      },
      "additionalProperties": false
    },
    "run_variant": {
      "type": "object",
      "required": ["status", "seed_artifacts"],
      "properties": {
        "status": {"const": "complete"},
        "seed_artifacts": {
          "type": "object",
          "required": ["16630", "16631", "16632"],
          "properties": {
            "16630": {"$ref": "#/$defs/artifact"},
            "16631": {"$ref": "#/$defs/artifact"},
            "16632": {"$ref": "#/$defs/artifact"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
